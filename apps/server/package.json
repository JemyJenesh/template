{
  "name": "server",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "copy-assets": "cp -r ./static ./dist/static",
    "build": "tsup && pnpm run copy-assets",
    "check-types": "tsc --noEmit",
    "dev": "tsup src/index.ts --watch --onSuccess \"pnpm run copy-assets && node --env-file=.env dist/index.js\"",
    "start": "node --env-file=.env dist/index.js",
    "db:generate": "pnpx prisma generate",
    "db:migrate": "pnpx prisma migrate dev",
    "db:seed": "pnpx prisma db seed",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.12.4",
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "@repo/shared": "workspace:*",
    "better-auth": "^1.3.4",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.2.0",
    "prisma": "^6.13.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seeds/index.ts"
  }
}
