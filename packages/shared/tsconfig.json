{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": "./",
    "declaration": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": "src/",
    "outDir": "./dist"
  },
  "include": ["src/**/*"]
}
